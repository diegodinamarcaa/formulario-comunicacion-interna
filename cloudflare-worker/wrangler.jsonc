{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ssm-comunicacion-interna",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comunicacion-interna",
      "database_id": "REEMPLAZAR_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "solicitudes-comunicacion"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://diegodinamarcaa.github.io",
    "NOTIFY_EMAIL": "ddinamarcaa@ssmaule.cl",
    "MAIL_PROVIDER": "none"
  }
}
